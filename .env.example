CERBOS_URL=http://10.17.1.201:3592
# 默认资源策略（未在 CERBOS_BUCKET_KINDS 中列出的 bucket 使用）
CERBOS_RESOURCE_KIND=minio_object
# bucket 到资源策略名的映射，格式 "bucket=kind,bucket2=kind2"
CERBOS_BUCKET_KINDS=aife=aife,dsh=dsh
# 网关挂载的路径前缀，带不带前导斜杠都可以
root_path=/share/s3
MINIO_ENDPOINT=https://oss.feg.cn
# MinIO 凭据可选：两项都留空则使用匿名（unsigned）访问，权限由 MinIO 桶策略决定。
# 两项都填写则使用该只读账号签名访问。
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
# 留空则跟随 MINIO_ENDPOINT 的协议（https:// → true，http:// → false）
MINIO_SECURE=true
LOG_LEVEL=INFO
